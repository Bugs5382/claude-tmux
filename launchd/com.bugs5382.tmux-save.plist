<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bugs5382.tmux-save</string>
  <key>ProgramArguments</key><array><string>__HOME__/.local/bin/tmux-save</string></array>
