#!/usr/bin/env bash
# Stands in for launchctl. State: 0 unloaded, 1 loaded, 10+n unloading (n more `print` calls
# still see it loaded, like the real asynchronous bootout). bootstrap fails unless unloaded.
state="$LAUNCHCTL_STATE"
loaded="$(cat "$state" 2>/dev/null || echo 0)"
case "$1" in
  print)
    case "$loaded" in
      0) exit 113 ;;
      1) exit 0 ;;
      10) echo 0 > "$state"; exit 113 ;;
      *) echo $((loaded - 1)) > "$state"; exit 0 ;;
    esac ;;
  bootout) echo 13 > "$state" ;;
  bootstrap)
    [ "$loaded" = 0 ] || { echo "Bootstrap failed: 5: Input/output error" >&2; exit 5; }
    echo 1 > "$state" ;;
esac
exit 0
