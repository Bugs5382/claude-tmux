#!/usr/bin/env bash
# Start the OPS session with Claude in it if it isn't running, ask which prefix to use, then attach.
set -euo pipefail

sock="${TMUX_SOCKET_NAME:-default}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The install links this file onto PATH; lib/ is only in the checkout.
root="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
t() { tmux -L "$sock" ${TMUX_CONFIG:+-f "$TMUX_CONFIG"} "$@"; }

if [ "$#" -gt 0 ]; then
  echo "usage: tmux-start" >&2
  exit 64
fi

# Typed into the shell, as tmux-restore does, so the pane survives Claude exiting.
if ! t has-session -t "=OPS" 2>/dev/null; then
  t new-session -d -s OPS
  t send-keys -t "=OPS:" "claude" Enter
fi

"$root/lib/update-check.sh" </dev/null >/dev/null 2>&1 &

if [ ! -t 0 ] || [ ! -t 1 ]; then
  echo "tmux-start: not attaching; run: tmux attach -t '=OPS'"
  exit 0
fi
"$here/tmux-prefix"
if [ -n "${TMUX:-}" ]; then
  t switch-client -t "=OPS"
else
  exec tmux -L "$sock" ${TMUX_CONFIG:+-f "$TMUX_CONFIG"} attach -t "=OPS"
fi
